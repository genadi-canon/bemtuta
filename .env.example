# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used in notification links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron (Vercel sends it automatically when set as an env var)
CRON_SECRET=

# Optional: WhatsApp / SMS notifications through Twilio. Without these, notifications are only logged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
